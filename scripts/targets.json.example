{
  "_comment": "Copy to targets.json (./targets.json for npm CLI, or scripts/targets.json in a git clone). repos are directory names under SYNC_REPO_ROOT (default: cwd for npm, parent of this repo for dev clone). Only git-tracked files are uploaded.",
  "_includePaths_comment": "ALLOWLIST, optional, per repo. When present, ONLY paths under these prefixes are eligible for the corpus and everything else is refused. Use it when the corpus boundary matters: a denylist is fail-OPEN, so a new top-level file silently joins the corpus, whereas an allowlist is fail-CLOSED. Omit for a repo to keep the old behaviour of admitting everything.",
  "includePaths": {
    "example-repo": ["docs/"]
  },
  "_excludePaths_comment": "DENYLIST, optional, per repo. Applied after includePaths.",
  "excludePaths": {
    "example-repo": ["vendor/private-notes/"]
  },
  "restrictedRepos": [],
  "targets": {
    "corpus": {
      "instance": "my-ai-search-instance",
      "bucket": "my-search-corpus",
      "repos": ["example-repo"]
    }
  }
}
