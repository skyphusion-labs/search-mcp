# search-mcp bearer-gated MCP Worker (wrangler.mcp.toml example)
#
# Copy to wrangler.mcp.toml and edit instance_name / routes before deploy.
# Set the gate secret with:
#   wrangler secret put MCP_TOKEN -c wrangler.mcp.toml

name = "search-mcp"
main = "src/mcp.ts"
compatibility_date = "2026-03-27"
compatibility_flags = ["nodejs_compat"]
workers_dev = false

[observability]
enabled = true

[[ai_search]]
binding = "SEARCH"
instance_name = "my-ai-search-instance"
# remote = true   # uncomment for `wrangler dev`

# Same R2 bucket the corpus sync uploads to (enables get_file, list_repos via
# prefixes, corpus_status via _meta/corpus-status.json). Optional but recommended.
# [[r2_buckets]]
# binding = "CORPUS"
# bucket_name = "my-corpus-bucket"

[vars]
# JSON array of repo names, or {"repos":["a","b"],"description":"..."}.
# When set, list_repos prefers this over R2 prefix scan.
# CORPUS_REPOS = '["my-repo"]'
# GENERATION_MODEL = "@cf/meta/llama-3.1-8b-instruct"
# GET_FILE_MAX_BYTES = "65536"

# Optional custom domain (or use workers.dev):
# [[routes]]
# pattern = "mcp-search.example.com"
# custom_domain = true
